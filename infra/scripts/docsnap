#!/usr/bin/env bash
# 未版本控制的协作文档的写前快照 / 完整性检查 / 恢复（CR-068）。
#
# 为什么需要它：`AGENTS.md`、`progress.md` 等 9 份协作文档全部在
# `.gitignore` 里（AGENTS.md §7 的既定安排），没有 git 副本。2026-09-08
# 一次批量替换脚本误用开放式切片，把 `progress.md` 从中部截断到文件末尾，
# 约 1400 行历史记录不可恢复——当时既没有快照，也没有任何"文件突然
# 少了一大半"的检测。CR-068 要求把"操作约束"升级成真正的恢复能力。
#
# 用法:
#   docsnap save [说明]     写前快照：把 9 份文档连同行数/字节数/sha256 存一份
#   docsnap list            列出现有快照
#   docsnap check           把当前文档与最近一次快照比对，**任何删除**都报错退出
#   docsnap accept <文件> "理由"  有意删减：**逐文件**记录理由并重建基线
#   docsnap changes [文件]  相对最近快照的完整 diff——先看清楚删了什么
#   docsnap diff [文件]     显示当前文档与最近快照的行数/字节数差
#   docsnap restore <快照> [文件]   从指定快照恢复（不带文件名则恢复全部）
#   docsnap drill           自检演练：在临时目录里真实跑一遍 保存→破坏→恢复
#
# 环境变量（仅供测试/演练覆盖，正常使用不需要设置）:
#   DOCSNAP_ROOT   文档所在目录，默认仓库根
#   DOCSNAP_STORE  快照存放目录，默认 $DOCSNAP_ROOT/data/doc-snapshots
#   DOCSNAP_DOCS   要快照的文件名清单（空格分隔），默认下面的 DEFAULT_DOCS
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
ROOT="${DOCSNAP_ROOT:-$REPO_ROOT}"
# 快照放在 data/ 下：这个目录本来就在 .gitignore 里（`/data/`），因此
# 不需要动用户的 .gitignore 就能保证快照不会被提交。**代价**：谁要是
# 为了重建索引整个删掉 data/，快照会一并没了——所以 KEEP_MIN 保得住的
# 只是"没人删目录"这个前提下的历史。
STORE="${DOCSNAP_STORE:-$ROOT/data/doc-snapshots}"

DEFAULT_DOCS="AGENTS.md scope.md architecture.md development.md development-notes.md plan.md progress.md code-review.md wait-for-review.md"
DOCS="${DOCSNAP_DOCS:-$DEFAULT_DOCS}"

# 保留策略：至少留最近 KEEP_MIN 份；超过 KEEP_MIN 的部分里，超过
# KEEP_DAYS 天的删掉。两条一起保证"最近的一定在"且"不会无限增长"。
KEEP_MIN=20
KEEP_DAYS=30

# check 的判定（CR-069 后收紧）：
#   1) **任何**行数或字节数比最近快照少 -> 非零。不再有"少一点点算正常"
#      的阈值——CR-069 复现过 1000 行文档中部丢 100 行（10%）会被旧的
#      200 行/20% 阈值放过，而那 100 行完全可能正是一段基准或风险记录。
#   2) 即使净行数没减少，只要 diff 里**任何一个 hunk 净删 >0 行**（删的
#      行多于加的行）也判非零——否则"中间删 100 行、末尾追加 150 行"这种
#      净增长的删除会从计数比较里溜过去。CR-071：这里原来卡在"净删 ≥10
#      行"，于是"十处各净删 9 行 + 末尾追加"能同时绕过三条判据；阈值本身
#      就是豁免，现在没有阈值。同一 hunk 里等量或变长的普通改写（删 1 加 1、
#      删 1 加 2）净删为 0，仍然是 0，不会把正常编辑拦下来。
#   有意删减走 `docsnap accept "理由"`：它记录理由并重建基线，是一个
#   显式动作，不是把判据调松。
# 这两条之外仍然保留一档更醒目的措辞（BIG_*），只影响提示文字、不影响
# 退出码，方便人一眼区分"顺手删了一段"和"半个文件没了"。
BIG_LINES=200
BIG_RATIO=20   # 百分比

_sha() { shasum -a 256 "$1" | awk '{print $1}'; }

_manifest_line() {  # <文件名> <路径>
  printf '%s\t%s\t%s\t%s\n' "$1" "$(wc -l < "$2" | tr -d ' ')" "$(wc -c < "$2" | tr -d ' ')" "$(_sha "$2")"
}

_latest() { ls -1 "$STORE" 2>/dev/null | grep -E '^[0-9]{8}T[0-9]{6}Z' | sort | tail -1; }

_prune() {
  # 不用 mapfile：macOS 自带的是 bash 3.2，没有这个内建命令。
  local all count keep_from i=0 name age_days now
  all="$(ls -1 "$STORE" 2>/dev/null | grep -E '^[0-9]{8}T[0-9]{6}Z' | sort || true)"
  [ -z "$all" ] && return 0
  count="$(printf '%s\n' "$all" | wc -l | tr -d ' ')"
  [ "$count" -le "$KEEP_MIN" ] && return 0
  keep_from=$(( count - KEEP_MIN ))   # 前 keep_from 个是"超出保底数量"的老快照
  now="$(date -u +%s)"
  while IFS= read -r name; do
    i=$(( i + 1 ))
    [ "$i" -gt "$keep_from" ] && break
    age_days=$(( ( now - $(date -u -j -f '%Y%m%dT%H%M%SZ' "${name%%__*}" +%s 2>/dev/null || echo "$now") ) / 86400 ))
    if [ "$age_days" -gt "$KEEP_DAYS" ]; then rm -rf "${STORE:?}/$name"; fi
  done <<EOF
$all
EOF
}

cmd_save() {
  local reason="${1:-}" stamp dir f seq
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  # 同一秒里可能存一份以上（accept 紧接着 save）。加两位序号，并且序号
  # 放在说明之前——目录名的字典序必须与创建顺序一致，否则 `_latest` 会
  # 挑错基线。这条是实测踩出来的：`__accept-` 字典序排在 `__t-` 前面，
  # accept 之后 check 仍拿旧基线比对，看起来像"接受没生效"。
  seq="$(ls -1 "$STORE" 2>/dev/null | grep -c "^${stamp}__" || true)"
  seq="$(printf '%02d' $(( seq + 1 )))"
  dir="$STORE/${stamp}__${seq}"
  [ -n "$reason" ] && dir="${dir}__$(echo "$reason" | tr -c 'A-Za-z0-9_-' '-' | cut -c1-40)"
  mkdir -p "$dir"
  : > "$dir/MANIFEST.tsv"
  for f in $DOCS; do
    if [ -f "$ROOT/$f" ]; then
      cp "$ROOT/$f" "$dir/$f"
      _manifest_line "$f" "$ROOT/$f" >> "$dir/MANIFEST.tsv"
    fi
  done
  [ -n "$reason" ] && printf '%s\n' "$reason" > "$dir/REASON.txt"
  _prune
  echo "快照 $(basename "$dir")：$(wc -l < "$dir/MANIFEST.tsv" | tr -d ' ') 份文档 -> $dir"
  cat "$dir/MANIFEST.tsv" | awk -F'\t' '{printf "  %-24s %6s 行 %9s 字节\n", $1, $2, $3}'
}

cmd_list() {
  local d
  [ -d "$STORE" ] || { echo "还没有任何快照（$STORE 不存在）"; return 0; }
  for d in $(ls -1 "$STORE" | grep -E '^[0-9]{8}T[0-9]{6}Z' | sort); do
    printf '%s  %s\n' "$d" "$(cat "$STORE/$d/REASON.txt" 2>/dev/null || echo '-')"
  done
}

# 某个文件相对快照的删除情况：输出 "净行差 净字节差 最大块删除 总删行 总加行"
_delta() {  # <快照文件> <当前文件>
  local snap_f="$1" cur_f="$2"
  { diff -u "$snap_f" "$cur_f" 2>/dev/null || true; } | awk '
    /^@@/ { if (del - add > worst) worst = del - add; del = 0; add = 0; next }
    /^---/ || /^\+\+\+/ { next }
    /^-/ { del++; tdel++; next }
    /^\+/ { add++; tadd++; next }
    END { if (del - add > worst) worst = del - add; print worst+0, tdel+0, tadd+0 }
  '
}

cmd_check() {
  local latest dir rc=0 name lines bytes sha now_lines now_bytes now_sha
  local line_drop byte_drop worst tdel tadd ratio label
  latest="$(_latest)" || true
  if [ -z "${latest:-}" ]; then
    echo "没有可比对的快照——先跑一次 docsnap save" >&2
    return 2
  fi
  dir="$STORE/$latest"
  echo "与快照 $latest 比对："
  while IFS=$'\t' read -r name lines bytes sha || [ -n "${name:-}" ]; do
    [ -z "${name:-}" ] && continue
    if [ ! -f "$ROOT/$name" ]; then
      echo "  ✗ $name 不存在了（快照里有 $lines 行）" >&2; rc=1; continue
    fi
    now_lines=$(wc -l < "$ROOT/$name" | tr -d ' ')
    now_bytes=$(wc -c < "$ROOT/$name" | tr -d ' ')
    now_sha="$(_sha "$ROOT/$name")"
    if [ "$now_sha" = "$sha" ]; then echo "  = $name 未改动（$now_lines 行）"; continue; fi

    line_drop=$(( lines - now_lines ))
    byte_drop=$(( bytes - now_bytes ))
    set -- $(_delta "$dir/$name" "$ROOT/$name")
    worst="${1:-0}"; tdel="${2:-0}"; tadd="${3:-0}"

    if [ "$line_drop" -gt 0 ] || [ "$byte_drop" -gt 0 ] || [ "$worst" -gt 0 ]; then
      ratio=0; [ "$lines" -gt 0 ] && [ "$line_drop" -gt 0 ] && ratio=$(( line_drop * 100 / lines ))
      if [ "$line_drop" -ge "$BIG_LINES" ] || { [ "$ratio" -ge "$BIG_RATIO" ] && [ "$line_drop" -gt 0 ]; }; then
        label="疑似大段截断"
      elif [ "$line_drop" -gt 0 ]; then
        label="行数减少"
      elif [ "$byte_drop" -gt 0 ]; then
        label="行数没少但内容变短"
      else
        label="净行数没减少，但有 hunk 净删了行"
      fi
      echo "  ✗ $name ${label}：$lines -> $now_lines 行（$bytes -> $now_bytes 字节）；" \
           "diff 删 $tdel 行 / 加 $tadd 行，单块最多净删 $worst 行" >&2
      rc=1
    else
      echo "  + $name $lines -> $now_lines 行（$bytes -> $now_bytes 字节）；删 $tdel 行 / 加 $tadd 行"
    fi
  done < "$dir/MANIFEST.tsv"
  if [ "$rc" -ne 0 ]; then
    {
      echo ""
      echo "有文档发生了删除。两条路，**都要人先看一眼**："
      echo "  1) 不是有意的  -> docsnap restore $latest <文件名>   从快照恢复"
      echo "  2) 是有意删的  -> docsnap accept <文件名> \"删了什么、为什么\"（逐文件）"
      echo "看清楚删了什么：docsnap changes <文件名>"
    } >&2
  fi
  return "$rc"
}

# 有意删减的显式接受：**必须点名是哪一份文档**，必须给理由。
# CR-070：原来的 `accept "理由"` 直接把九份文档的当前内容一起做成新基线——
# 接受 A 的有意删减时，B 的意外截断会被一并洗白，而且事后无从追溯。现在
# 新基线里**只有被点名的那一份**取当前内容，其余全部沿用上一份基线，
# 因此别的文档如果有未被接受的删除，下一次 check 照样报红。
cmd_accept() {
  local file="${1:-}" reason="${2:-}" latest dir newdir name lines bytes sha seq stamp
  if [ -z "$file" ] || [ -z "$reason" ]; then
    echo "用法: docsnap accept <文件名> \"删了什么、为什么\"" >&2
    echo "  文件名与理由都必填——这是一次有记录的、**逐文件**的基线重建，" >&2
    echo "  不是把判据调松，也不能顺手把别的文档的改动一起洗白。" >&2
    return 2
  fi
  latest="$(_latest)" || true
  if [ -z "${latest:-}" ]; then
    echo "还没有基线快照，先跑 docsnap save" >&2; return 2
  fi
  dir="$STORE/$latest"
  if ! grep -q "^${file}	" "$dir/MANIFEST.tsv" 2>/dev/null; then
    echo "基线快照里没有这份文档: $file" >&2; return 2
  fi
  [ -f "$ROOT/$file" ] || { echo "当前工作区没有这份文档: $file" >&2; return 2; }

  echo "接受 $file 的改动。相对基线 $latest 被删掉的行："
  # `set -o pipefail` 下 diff 的"文件不同"退出码 1 会让整条管道非零，
  # 这里是有意展示差异，不是错误——显式吞掉。
  { diff -u "$dir/$file" "$ROOT/$file" 2>/dev/null || true; } \
    | awk '/^---/ || /^\+\+\+/ {next} /^-/ {print "  " $0}' | head -40
  echo "（以上最多显示 40 行；完整差异用 docsnap changes ${file}）"

  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  seq="$(ls -1 "$STORE" 2>/dev/null | grep -c "^${stamp}__" || true)"
  seq="$(printf '%02d' $(( seq + 1 )))"
  newdir="$STORE/${stamp}__${seq}__accept-$(echo "$file" | tr -c 'A-Za-z0-9_-' '-' | cut -c1-24)"
  mkdir -p "$newdir"
  : > "$newdir/MANIFEST.tsv"
  # 被点名的文件取**当前**内容；其余一律沿用上一份基线的内容。
  while IFS=$'\t' read -r name lines bytes sha || [ -n "${name:-}" ]; do
    [ -z "${name:-}" ] && continue
    if [ "$name" = "$file" ]; then
      cp "$ROOT/$name" "$newdir/$name"
    else
      cp "$dir/$name" "$newdir/$name"
    fi
    _manifest_line "$name" "$newdir/$name" >> "$newdir/MANIFEST.tsv"
  done < "$dir/MANIFEST.tsv"

  {
    echo "接受的文档: $file"
    echo "理由: $reason"
    echo "接受时间: $stamp"
    echo "上一基线: $latest"
    echo "被接受掉的删除行（最多 40 行）:"
    { diff -u "$dir/$file" "$ROOT/$file" 2>/dev/null || true; } \
      | awk '/^---/ || /^\+\+\+/ {next} /^-/ {print}' | head -40
  } > "$newdir/ACCEPTED.txt"
  echo "已重建基线：$(basename "$newdir")（只有 $file 取当前内容，其余沿用上一份基线）"
}

# 看清楚到底删了什么：直接给出相对最近快照的 diff。
cmd_changes() {
  local latest dir name lines bytes sha
  latest="$(_latest)" || true
  [ -n "${latest:-}" ] || { echo "还没有快照" >&2; return 2; }
  dir="$STORE/$latest"
  while IFS=$'\t' read -r name lines bytes sha || [ -n "${name:-}" ]; do
    [ -z "${name:-}" ] && continue
    if [ -n "${1:-}" ] && [ "$1" != "$name" ]; then continue; fi
    [ -f "$ROOT/$name" ] || continue
    [ "$(_sha "$ROOT/$name")" = "$sha" ] && continue
    echo "=== ${name}（相对快照 ${latest}）"
    diff -u "$dir/$name" "$ROOT/$name" || true
  done < "$dir/MANIFEST.tsv"
}

cmd_restore() {
  local snap="${1:-}" only="${2:-}" dir name lines bytes sha
  [ -n "$snap" ] || { echo "用法: docsnap restore <快照目录名> [文件名]" >&2; return 2; }
  dir="$STORE/$snap"
  [ -d "$dir" ] || { echo "没有这个快照: $snap" >&2; return 2; }
  while IFS=$'\t' read -r name lines bytes sha || [ -n "${name:-}" ]; do
    [ -z "${name:-}" ] && continue
    if [ -n "$only" ] && [ "$only" != "$name" ]; then continue; fi
    cp "$dir/$name" "$ROOT/$name"
    echo "已恢复 ${name}（$lines 行，$bytes 字节）"
  done < "$dir/MANIFEST.tsv"
}

cmd_diff() {
  local latest dir name lines bytes sha
  latest="$(_latest)"; dir="$STORE/$latest"
  while IFS=$'\t' read -r name lines bytes sha || [ -n "${name:-}" ]; do
    [ -z "${name:-}" ] && continue
    if [ -n "${1:-}" ] && [ "$1" != "$name" ]; then continue; fi
    printf '%-24s 快照 %6s 行 / 现在 %6s 行\n' "$name" "$lines" "$(wc -l < "$ROOT/$name" | tr -d ' ')"
  done < "$dir/MANIFEST.tsv"
}

# 演练：在临时目录里真跑一遍"写前快照 → 把文件截断成事故那种样子 →
# check 必须报错 → restore 必须逐字节还原"。不碰真实文档。
cmd_drill() {
  local tmp doc snap rc
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' RETURN
  mkdir -p "$tmp/repo"
  doc="$tmp/repo/progress.md"
  seq 1 2000 | sed 's/^/第 & 行：历史实测记录/' > "$doc"
  export DOCSNAP_ROOT="$tmp/repo" DOCSNAP_STORE="$tmp/store" DOCSNAP_DOCS="progress.md"

  echo "1) 写前快照"
  ROOT="$tmp/repo" STORE="$tmp/store" DOCS="progress.md" cmd_save "drill" > /dev/null
  snap="$(STORE="$tmp/store" _latest)"

  echo "2) 模拟 2026-09-08 那次事故：从中部截断到文件末尾"
  head -561 "$doc" > "$doc.tmp" && mv "$doc.tmp" "$doc"

  echo "3) check 必须发现缩水"
  rc=0
  ROOT="$tmp/repo" STORE="$tmp/store" cmd_check > /dev/null 2>&1 || rc=$?
  [ "$rc" -eq 1 ] || { echo "演练失败：check 没有把 2000 -> 561 行判成异常" >&2; return 1; }
  echo "   ✓ check 退出码 1"

  echo "4) restore 必须逐字节还原"
  ROOT="$tmp/repo" STORE="$tmp/store" cmd_restore "$snap" progress.md > /dev/null
  if ! diff -q "$tmp/store/$snap/progress.md" "$doc" > /dev/null; then
    echo "演练失败：恢复后的文件与快照不一致" >&2; return 1
  fi
  [ "$(wc -l < "$doc" | tr -d ' ')" = "2000" ] || { echo "演练失败：恢复后行数不对" >&2; return 1; }
  echo "   ✓ 2000 行原样找回，sha256 与快照一致"

  # CR-069：只演练"大截断"不够——审查方复现的是 1000 行里中部丢 100 行
  # （10%），旧阈值会放过。这里把两种更隐蔽的形状也纳入演练。
  echo "5) 中段小删除（2000 行里删中间 100 行，5%）也必须被判非零"
  awk 'NR<900 || NR>999' "$doc" > "$doc.tmp" && mv "$doc.tmp" "$doc"
  rc=0; ROOT="$tmp/repo" STORE="$tmp/store" cmd_check > /dev/null 2>&1 || rc=$?
  [ "$rc" -eq 1 ] || { echo "演练失败：中段删 100 行没有被判非零" >&2; return 1; }
  echo "   ✓ check 退出码 1"

  echo "6) 被追加掩盖的删除（净行数增加）同样必须被判非零"
  ROOT="$tmp/repo" STORE="$tmp/store" cmd_restore "$snap" progress.md > /dev/null
  awk 'NR<900 || NR>999' "$doc" > "$doc.tmp" && mv "$doc.tmp" "$doc"
  seq 1 300 | sed 's/^/本轮新增第 & 行/' >> "$doc"
  rc=0; ROOT="$tmp/repo" STORE="$tmp/store" cmd_check > /dev/null 2>&1 || rc=$?
  [ "$rc" -eq 1 ] || { echo "演练失败：净增长但中间被删 100 行，没有被判非零" >&2; return 1; }
  echo "   ✓ check 退出码 1（净 +200 行，仍然报出整块删除）"

  echo "7) 分散的小删除（十处各净删 9 行）+ 追加，同样必须被判非零"
  ROOT="$tmp/repo" STORE="$tmp/store" cmd_restore "$snap" progress.md > /dev/null
  awk 'BEGIN{for(i=0;i<10;i++){lo=200+i*100; hi=lo+8; L[lo]=hi}}
       { drop=0; for (lo in L) if (NR>=lo && NR<=L[lo]) drop=1; if (!drop) print }' \
      "$doc" > "$doc.tmp" && mv "$doc.tmp" "$doc"
  seq 1 300 | sed 's/^/本轮新增第 & 行/' >> "$doc"
  rc=0; ROOT="$tmp/repo" STORE="$tmp/store" cmd_check > /dev/null 2>&1 || rc=$?
  [ "$rc" -eq 1 ] || { echo "演练失败：十处各删 9 行 + 追加没有被判非零（CR-071）" >&2; return 1; }
  echo "   ✓ check 退出码 1（净 +210 行，仍然报出每处 9 行的删除）"

  echo "8) 有意删减走 accept <文件> \"理由\"：只接受被点名的那一份"
  # 再造一份"意外被截断"的文档，验证接受 A 不会把 B 一起洗白（CR-070）
  printf '第 %s 行\n' $(seq 1 400) > "$tmp/repo/architecture.md"
  export DOCSNAP_DOCS="progress.md architecture.md"
  ROOT="$tmp/repo" STORE="$tmp/store" DOCS="progress.md architecture.md" cmd_save "两份" > /dev/null
  snap="$(STORE="$tmp/store" _latest)"
  awk 'NR<300 || NR>399' "$doc" > "$doc.tmp" && mv "$doc.tmp" "$doc"       # A：有意删
  head -100 "$tmp/repo/architecture.md" > "$tmp/x" && mv "$tmp/x" "$tmp/repo/architecture.md"  # B：意外截断
  ROOT="$tmp/repo" STORE="$tmp/store" DOCS="progress.md architecture.md" \
    cmd_accept progress.md "演练：确认删掉的是过时段落" > /dev/null
  rc=0; ROOT="$tmp/repo" STORE="$tmp/store" DOCS="progress.md architecture.md" cmd_check > /dev/null 2>&1 || rc=$?
  [ "$rc" -eq 1 ] || { echo "演练失败：接受 A 之后，B 的意外截断被一起洗白了（CR-070）" >&2; return 1; }
  if ! diff -q "$tmp/store/$snap/architecture.md" \
       "$tmp/store/$(STORE="$tmp/store" _latest)/architecture.md" > /dev/null; then
    echo "演练失败：未被接受的 B 在新基线里没有沿用旧版本（CR-070）" >&2; return 1
  fi
  [ -f "$tmp/store/$(STORE="$tmp/store" _latest)/ACCEPTED.txt" ] || {
    echo "演练失败：accept 没有落盘理由" >&2; return 1; }
  echo "   ✓ 只有 progress.md 被接受；architecture.md 的截断仍报红、旧版本仍在基线里"

  echo "演练通过：截断、中段删除、被追加掩盖的删除、分散删除都拦得住；"
  echo "         恢复可用，accept 逐文件生效且不会顺手洗白别的文档。"
}

case "${1:-}" in
  save)    shift; cmd_save "${1:-}" ;;
  list)    cmd_list ;;
  check)   cmd_check ;;
  accept)  shift; cmd_accept "${1:-}" "${2:-}" ;;
  changes) shift; cmd_changes "${1:-}" ;;
  diff)    shift; cmd_diff "${1:-}" ;;
  restore) shift; cmd_restore "${1:-}" "${2:-}" ;;
  drill)   cmd_drill ;;
  *) sed -n '2,25p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
